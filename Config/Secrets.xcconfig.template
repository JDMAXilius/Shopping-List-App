// Copy to Config/Secrets.xcconfig (gitignored) and fill in. NEVER commit the copy.
// xcconfig treats "//" as a comment — write https:/$()/ for the scheme.
SCAN_RECEIPT_ENDPOINT = https:/$()/YOUR-PROJECT.supabase.co/functions/v1/scan-receipt
// The project root. Without it every phone is local-only and NOTHING syncs — silently.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
